### Environment setting
MAX_TQALL=1
MAX_SYNTHSTRIP=1
MAX_SEGMENTBS=1

### Process setting
# tq_10
COST1=corratio
COST2=normmi
COST3=auto

# tq_30
N_MODAL=2

C1_EROSION_OPTION="--x 5 --y 5 --z 5 --cube 3"
C1_TUNED_MEAN=2

C2_EROSION_OPTION="--x 5 --y 5 --z 5 --cube 3"
C2_TUNED_MEAN=2

CURVEFIT_FALLBACK=true # The fallback process without parameter bounds runs if curve_fit fails.
OUTFIGSIZE=4
OUTFIGTYPE=3

# tq_40
OVERVIEW_THR=1
OVERVIEW_UTHR=2
